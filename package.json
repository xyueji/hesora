{
  "name": "hesora-inventory",
  "version": "1.2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "禾序进销存 · HESORA Inventory — 货有数，账有序。",
  "main": "./out/main/index.js",
  "author": "HESORA",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "pnpm dist",
    "pretest": "node tools/check-node.cjs",
    "predev": "node tools/check-node.cjs",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "dist": "node tools/prepare-windows-native.cjs && electron-vite build && electron-builder --win --x64",
    "dist:release": "node tools/check-website-release.cjs && node tools/prepare-windows-native.cjs && electron-vite build && electron-builder --win --x64",
    "dist:release:signed": "node tools/check-website-release.cjs && node tools/prepare-windows-native.cjs && electron-vite build && electron-builder --win --x64 --config.forceCodeSigning=true",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@peculiar/x509": "^3.1.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  },
  "build": {
    "appId": "com.hesora.inventory",
    "productName": "禾序进销存",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "src/main/db/migrations",
        "to": "migrations"
      },
      {
        "from": "resources/hesora.png",
        "to": "hesora.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/hesora.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-setup.exe",
      "shortcutName": "禾序进销存",
      "uninstallDisplayName": "禾序进销存",
      "installerIcon": "resources/hesora.ico",
      "uninstallerIcon": "resources/hesora.ico"
    }
  }
}
